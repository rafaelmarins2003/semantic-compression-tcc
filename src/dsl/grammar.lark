// BPMN-DSL v2 — see src/data/manipulation/deterministic/dsl_documentation.txt
//
// Design goals over v1:
//   - named events (start "Init", end "OK")
//   - empty branches as first-class () syntax (no more `task "empty"` hack)
//   - stable CNAME ids for refs (#order_proc) instead of name-based (#"Name")
//   - lane as scope (@lane "X" { ... }) instead of duplicated declaration+flow
//   - eventBasedGateway as `event { ... }`
//   - collaboration with explicit `message ... from #a to #b`
//
// Terminals tagged .2 take priority over CNAME (.1) to keep keywords
// unambiguous when an element ID happens to match a keyword.

start: top_level*

?top_level: process
          | pool
          | collaboration
          | note

// ── Process / Pool / Collaboration ────────────────────────────────────────

process:       "process"       NAME id_opt "{" process_body "}"
pool:          "pool"          NAME id_opt "{" process_body "}"
collaboration: "collaboration" NAME id_opt "{" pool+ message_flow* "}"

// Lane-scoped or plain flow (mutually exclusive).
?process_body: laneset
             | flow

laneset:    lane_block+
// Optional leading "->" inside a lane block signals continuity from the
// previous lane block (no new node, just sequenceFlow into the first
// element of this block).
lane_block: "@lane" NAME id_opt "{" "->"? flow "}"

// Flow = one or more steps connected by "->".
flow: step ("->" step)*

?step: event
     | task
     | gateway
     | subprocess
     | call_activity
     | ref
     | note

// ── Events ────────────────────────────────────────────────────────────────

?event: start_event | end_event | catch_event | throw_event

// Order: keyword, optional event_spec, optional name, optional id, optional props.
// `end:error "Timeout"` parses as kind=error, name=Timeout (consistent with spec).
start_event: "start" event_spec? NAME? id_opt props?
end_event:   "end"   event_spec? NAME? id_opt props?
catch_event: "catch" event_spec  NAME? id_opt props?
throw_event: "throw" event_spec  NAME? id_opt props?

event_spec: ":" EVENT_KIND ("(" NAME ")")?

EVENT_KIND.2: "none" | "message" | "timer" | "error" | "signal" | "escalation"

// ── Tasks ─────────────────────────────────────────────────────────────────

task: TASK_TYPE NAME id_opt props?

TASK_TYPE.2: "task" | "user" | "service" | "manual" | "script"
           | "send" | "receive" | "rule"

// ── Gateways ──────────────────────────────────────────────────────────────

?gateway: xor_gw | and_gw | or_gw | event_gw

xor_gw:   "xor"   NAME? id_opt "{" cond_branch+ "}"
or_gw:    "or"    NAME? id_opt "{" cond_branch+ "}"
event_gw: "event" NAME? id_opt "{" event_branch+ "}"
and_gw:   "and"   NAME? id_opt "{" and_branches  "}"

cond_branch:  "[" CONDITION_TEXT "]" "->" branch_target
event_branch: "[" event_spec     "]" "->" branch_target
and_branches: branch_target (";" branch_target)*

?branch_target: flow | empty_branch
empty_branch:  "(" ")"

CONDITION_TEXT: /[^\[\]]+/

// ── Subprocess / Call activity ────────────────────────────────────────────

subprocess:    "subprocess" NAME id_opt "{" process_body "}"
call_activity: "call"       NAME id_opt props?

// ── Reference (back-edge or convergence) ──────────────────────────────────

ref: "#" CNAME

// ── Annotation ────────────────────────────────────────────────────────────

note: "note" NAME id_opt

// ── Message flow (only inside collaboration) ──────────────────────────────

message_flow: "message" NAME? "from" ref "to" ref props?

// ── Optional ID suffix on any nameable element ────────────────────────────

id_opt: ("#" CNAME)?

// ── Properties ────────────────────────────────────────────────────────────

props: "(" prop ("," prop)* ")"
prop:  CNAME "=" NAME

// ── Terminals ─────────────────────────────────────────────────────────────

NAME: ESCAPED_STRING

%import common.ESCAPED_STRING
%import common.CNAME
%import common.WS
%ignore WS
%ignore /\/\/[^\n]*/
