// BPMN-DSL Grammar — Compact notation for BPMN 2.0 processes
// Compresses ~91% of token count compared to raw BPMN 2.0 XML.
//
// Terminals marked .2 have priority over CNAME (priority 1) to avoid
// keyword/identifier conflicts. Prop keys (CNAME) must not be grammar keywords.

start: top_level+

// Inline pass-through: no extra wrapper node for top-level constructs.
?top_level: process | pool | collaboration

// ── Collaboration (multi-pool) ─────────────────────────────────────────────
// Represents a BPMN 2.0 Collaboration element with two or more participants.
// Message flows are inferred by matching throw/catch message event names.

collaboration: "collaboration" ESCAPED_STRING "{" pool+ "}"

// ── Pool ──────────────────────────────────────────────────────────────────
// Represents a BPMN 2.0 Participant / Pool element.
// A pool can have lane structure (laneset) or a plain sequence flow (seq).

pool: "pool" ESCAPED_STRING "{" process_body "}"

// ── Process ───────────────────────────────────────────────────────────────

process: "process" ESCAPED_STRING "{" process_body "}"

// A process body is either:
//   - a plain seq (no lanes), or
//   - a laneset (lane membership declarations) followed by a seq
?process_body: seq | laneset

// ── Sequence flow ──────────────────────────────────────────────────────────
// Elements connected by "->"; transpiler generates sequence flow elements.

seq: step ("->" step)*

// Inline pass-through rules: removes extra Tree wrapper in parsed output.
?step: task
     | event
     | gateway
     | subprocess
     | call_activity
     | ref
     | note

// ── Tasks ─────────────────────────────────────────────────────────────────

task: TASK_TYPE ESCAPED_STRING props?

// Priority .2 beats CNAME (priority 1) in the lexer.
TASK_TYPE.2: "task"
           | "service"
           | "user"
           | "script"
           | "manual"
           | "send"
           | "receive"
           | "rule"

// ── Events ────────────────────────────────────────────────────────────────

?event: start_event | end_event | catch_event | throw_event

start_event: "start" event_spec?
end_event:   "end"   event_spec?
catch_event: "catch" event_spec
throw_event: "throw" event_spec

// event_spec encodes type and trigger name, e.g. :timer("PT2H"), :error("timeout")
event_spec: ":" EVENT_KIND "(" ESCAPED_STRING ")"

EVENT_KIND.2: "timer"
            | "message"
            | "error"
            | "signal"
            | "escalation"

// ── Gateways ──────────────────────────────────────────────────────────────

?gateway: xor_gw | and_gw | or_gw

// Exclusive (XOR): exactly one branch taken; transpiler inserts merge gateway.
xor_gw: "xor" ESCAPED_STRING? "{" branch+ "}"

// Parallel (AND): all branches taken concurrently, separated by comma.
// Transpiler inserts split + join AND gateways.
and_gw: "and" ESCAPED_STRING? "{" and_branches "}"

// Inclusive (OR): one or more branches taken based on conditions.
or_gw:  "or"  ESCAPED_STRING? "{" branch+ "}"

and_branches: seq ("," seq)*

// A conditional branch: [condition] -> continuation_sequence
// "default" is a valid condition value (transpiler sets isDefault=true).
branch: "[" CONDITION_TEXT "]" "->" seq

// Matches anything between [ ] except the brackets themselves.
CONDITION_TEXT: /[^\[\]]+/

// ── Subprocess ────────────────────────────────────────────────────────────

subprocess:    "subprocess" ESCAPED_STRING "{" seq "}"
call_activity: "call" ESCAPED_STRING

// ── Lanes ─────────────────────────────────────────────────────────────────
// laneset: one or more lane membership blocks, followed by the sequence flow.
// Lane blocks declare WHICH elements belong to each lane — not the flow order.
// Gateways are not declared in lanes; the transpiler auto-assigns them to the
// lane of their nearest source element.
//
// Example:
//   lane "Finance" { task "Pay Invoice", task "Reconcile" }
//   lane "Warehouse" { task "Pick Items", task "Ship Order", end }
//   start -> task "Pay Invoice" -> task "Pick Items" -> task "Ship Order" -> end

laneset: lane+ seq?

lane: "lane" ESCAPED_STRING "{" lane_members? "}"

lane_members: lane_el ("," lane_el)*

// Subset of step: tasks, events, subprocesses — no gateways, no refs.
// Gateways are structural (flow) elements, not swimlane membership elements.
?lane_el: task
        | start_event | end_event | catch_event | throw_event
        | subprocess | call_activity | note

// ── Named reference ───────────────────────────────────────────────────────
// References a previously named element for loops or converging flows.
// Example: -> #"Receive Order"  (loop back to that task)

ref: "#" ESCAPED_STRING

// ── Annotation ────────────────────────────────────────────────────────────

note: "note" ESCAPED_STRING

// ── Properties ────────────────────────────────────────────────────────────
// Key=value pairs attached to tasks/events. Keys must not be grammar keywords.
// Example: task "Pay" (performer="finance", documentation="See SLA doc")

props: "(" prop ("," prop)* ")"
prop:  CNAME "=" ESCAPED_STRING

// ── Terminals ─────────────────────────────────────────────────────────────

%import common.ESCAPED_STRING
%import common.CNAME
%import common.WS
%ignore WS
%ignore /\/\/.*/
