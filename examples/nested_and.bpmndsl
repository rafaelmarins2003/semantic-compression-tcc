// Insurance claim processing with parallel AND gateway, nested XOR, and lane hints
// Demonstrates: @lane scoped flow, AND gateway (3 parallel branches),
//               XOR nested inside an AND branch, subprocess, typed events, props.

process "Insurance Claim Processing" {
  @lane "Customer Service" {
    start:message("claim-submitted") "Claim submitted" ->
    task "Register Claim" (performer="claims-team") ->
    and "Parallel Assessment" {
      task "Medical Assessment" (lane="Medical Team") ->
      xor "Medical Result" {
        [fully covered] ->
          task "Approve Full Medical Benefit" (lane="Medical Team")
        [partially covered] ->
          task "Approve Partial Medical Benefit" (lane="Medical Team")
        [not covered] ->
          task "Reject Medical Claim" (lane="Medical Team")
      };
      task "Request Financial Documents" (lane="Financial Team") ->
      task "Verify Financial Documents" (lane="Financial Team") ->
      service "Calculate Financial Benefit" (performer="actuarial-system", lane="Financial Team");
      subprocess "Fraud Screening" {
        service "Run Automated Fraud Check" (lane="Fraud Prevention") ->
        xor "Fraud Detected?" {
          [yes] ->
            task "Flag for Investigation" (lane="Fraud Prevention") ->
            throw:signal("fraud-alert") "Fraud alert"
          [no] ->
            note "Screening passed"
        }
      }
    }
  }
  @lane "Claims Manager" {
    -> task "Consolidate Assessment" ->
    xor "Final Decision" {
      [approved] ->
        task "Issue Payment" ->
        task "Send Decision Letter" (lane="Customer Service") ->
        end:message("claim-resolved") "Claim resolved"
      [rejected] ->
        task "Send Rejection Letter" ->
        task "Send Decision Letter" (lane="Customer Service") ->
        end "Claim rejected"
    }
  }
}
