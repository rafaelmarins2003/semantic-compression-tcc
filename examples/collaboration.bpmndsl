// E-commerce order processing — collaboration between Customer and Online Shop
// Demonstrates: collaboration, multiple pools, @lane scoped flow,
//               typed message events, and explicit message flows.

collaboration "E-Commerce Order" {
  pool "Customer" {
    start ->
    task "Browse Products" ->
    task "Add to Cart" ->
    task "Submit Order" #submit_order ->
    xor "Order Outcome" {
      [confirmed] ->
        catch:message("order-confirmed") "Order confirmed" #customer_confirmed ->
        task "Receive Package" ->
        end
      [cancelled] ->
        catch:message("order-cancelled") "Order cancelled" #customer_cancelled ->
        task "Contact Support" ->
        end
    }
  }

  pool "Online Shop" {
    @lane "Sales" {
      start:message("order-submitted") "Order received" #receive_order ->
      task "Validate Order" ->
      xor "Stock Available?" {
        [yes] ->
          task "Confirm Order" ->
          task "Pick Items" (lane="Warehouse") ->
          task "Pack Order" (lane="Warehouse") ->
          task "Dispatch Package" (lane="Warehouse") ->
          throw:message("order-confirmed") "Order confirmed" #order_confirmed
        [no] ->
          task "Notify Out of Stock" (lane="Customer Support") ->
          throw:message("order-cancelled") "Order cancelled" #order_cancelled
      } ->
      task "Send Invoice" ->
      end
    }
  }

  message "Order submitted" from #submit_order to #receive_order
  message "Order confirmed" from #order_confirmed to #customer_confirmed
  message "Order cancelled" from #order_cancelled to #customer_cancelled
}
