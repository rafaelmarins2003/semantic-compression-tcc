# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ─── Virtual envs & package managers ─────────────────────────────────
.venv/
venv/
env/
.uv/
.uv-cache/

# ─── Testing / linting caches ────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/

# ─── Jupyter ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── ML artifacts (large binaries, training outputs) ─────────────────
experiments/checkpoints/
experiments/results/
*.bin
*.safetensors
*.pt
*.pth
*.gguf
*.onnx
mlruns/
wandb/

# ─── Datasets ────────────────────────────────────────────────────────
# Raw sources are too big / often licensed — keep out of git.
data/raw/
data/mad/
# SQLite database files (binary, ephemeral, recreated from pipeline).
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.bak
data/*.bak-*
data/*.before_*

# ─── Configs ─────────────────────────────────────────────────────────
# Default: hide local experiment configs / hyperparameters.
# Exception: prompt templates are part of the published methodology
# and MUST be tracked for TCC reproducibility.
# NOTE: use `configs/*` (not `configs/`) so that re-includes below work —
# git refuses to un-ignore files inside an explicitly excluded directory.
configs/*
!configs/prompts/

# ─── Logs & run artifacts ────────────────────────────────────────────
*.log
preprocess-*.log
logs/

# ─── Secrets ─────────────────────────────────────────────────────────
.env
.env.*
*.env

# ─── Editor / agent / IDE ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
.codex
CLAUDE.local.md
AGENTS.local.md
LOCAL_TODO.md

# ─── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── LaTeX build artifacts (article/) ────────────────────────────────
# Track .tex sources and final .pdf; ignore the build clutter.
article/**/*.aux
article/**/*.bbl
article/**/*.blg
article/**/*.fdb_latexmk
article/**/*.fls
article/**/*.lof
article/**/*.lot
article/**/*.out
article/**/*.synctex.gz
article/**/*.toc
article/**/*.run.xml
article/**/_minted-*/
article/**/auto/
article/**/*.acn
article/**/*.glo
article/**/*.idx
article/**/*.ilg
article/**/*.ind
article/**/*.ist
article/**/*.loa
article/**/*.lol
article/**/*.loq


# ─── Prompts ──────────────────────────────────────────────────────────
configs/prompts/private/


# ─── Others ───────────────────────────────────────────────────────────
AGENTS.md
CLAUDE.md
fontes.txt
experiments/sft/adapter/
# Subamostras da curva de aprendizado: derivadas de experiments/sft/train.jsonl
# por `uv run python -m src.training.subsample`, determinísticas e aninhadas.
# Versionar seria guardar cópia do que um comando regenera.
experiments/sft/lc*/
experiments/sft/adapter-*/
